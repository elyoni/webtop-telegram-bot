# Copy to .env (chmod 600). Never commit .env.
WEBTOP_USERNAME=
WEBTOP_PASSWORD=
# School-specific login `data` value (see pywebtop README)
WEBTOP_DATA=
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated admin user ids; send /start to the bot to see yours.
# Admins use the bot and approve other users with /allow (stored in the db).
TELEGRAM_ADMIN_IDS=
# Azure app registration (personal accounts, public client, Tasks.ReadWrite). Optional.
MS_CLIENT_ID=
# Optional overrides
# BOT_TIMEZONE=Asia/Jerusalem
# DIGEST_TIME=16:00
# REMINDER_TIME=20:00
# Automatic Webtop updates (comma-separated HH:MM)
# SYNC_TIMES=07:00,15:30
# Minimum minutes between Webtop updates (applies to /sync; failed attempts count too)
# SYNC_COOLDOWN_MINUTES=30
# Weeks stored around the current one
# SYNC_WEEKS_BACK=1
# SYNC_WEEKS_AHEAD=1
# DATA_DIR=data
